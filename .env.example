# SQLite by default -- works with zero setup.
# To move to Supabase/Postgres later, swap this for your Postgres connection
# string and change `provider = "sqlite"` to `provider = "postgresql"` in
# prisma/schema.prisma, then re-run `npm run prisma:migrate`.
DATABASE_URL="file:./dev.db"

# Google Places API key (Places API + Places API (New) enabled in Google Cloud).
# https://console.cloud.google.com/apis/credentials
# Without this set, the search page returns demo/sample data so you can try
# the app before wiring up billing.
GOOGLE_PLACES_API_KEY=

# Optional: used to auto-draft a sharper opening line per lead via Claude.
# Leave blank to fall back to the built-in template.
ANTHROPIC_API_KEY=
