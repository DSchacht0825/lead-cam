# Supabase Postgres connection strings.
# Get both from: Supabase project -> Connect button -> ORMs -> Prisma.
# DATABASE_URL: pooled (transaction mode, port 6543) -- used by the app at runtime.
# DIRECT_URL: unpooled (session mode, port 5432) -- used by Prisma for migrations.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# Google Places API (New) key. Enable "Places API (New)" in Google Cloud
# Console (Credentials page for the key itself):
# https://console.cloud.google.com/apis/credentials
# Without this set, search returns demo/sample data so you can try the app
# before wiring up billing.
GOOGLE_PLACES_API_KEY=

# Optional: used to auto-draft a sharper opening line per lead via Claude.
# Leave blank to fall back to the built-in template.
ANTHROPIC_API_KEY=

# Random secret authorizing the daily /api/cron/discover sweep. Generate
# with `openssl rand -hex 32`. Must also be set as a Vercel env var --
# Vercel Cron Jobs then send it automatically as a Bearer token.
CRON_SECRET=
