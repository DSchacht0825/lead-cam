generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Swap to "postgresql" + a Supabase connection string to move off SQLite.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so status is a plain string
// validated against lib/status.ts's STATUSES at the application layer.
// (Postgres/Supabase does support enums -- reintroduce one if you migrate.)
model Lead {
  id                String   @id @default(cuid())
  placeId           String   @unique
  name              String
  category           String
  city              String
  phone             String?
  googleMapsUrl     String?
  rating            Float?
  reviewCount       Int?
  hasWebsite        Boolean  @default(false)

  // Manual/assisted enrichment fields (Facebook scraping violates its ToS,
  // so these are filled in by the user via the "search Facebook" helper link).
  facebookUrl       String?
  facebookActive    Boolean  @default(false)
  instagramUrl      String?
  ownerOperated     Boolean  @default(false)

  score             Int      @default(0)
  hot               Boolean  @default(false)
  status            String   @default("NEW")
  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  activity          Activity[]
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  message   String
  createdAt DateTime @default(now())
}
