generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// status is a plain string validated against lib/status.ts's STATUSES at
// the application layer, rather than a Postgres enum, to match the schema
// exactly as already created in Supabase via supabase/schema.sql.
model Lead {
  id                String   @id @default(cuid())
  placeId           String   @unique
  name              String
  category           String
  city              String
  phone             String?
  googleMapsUrl     String?
  rating            Float?
  reviewCount       Int?
  hasWebsite        Boolean  @default(false)

  // Manual/assisted enrichment fields (Facebook scraping violates its ToS,
  // so these are filled in by the user via the "search Facebook" helper link).
  facebookUrl       String?
  facebookActive    Boolean  @default(false)
  instagramUrl      String?
  ownerOperated     Boolean  @default(false)

  score             Int      @default(0)
  hot               Boolean  @default(false)
  status            String   @default("NEW")
  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  activity          Activity[]
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  message   String
  createdAt DateTime @default(now())
}

model DiscoveryRun {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  citiesCount     Int
  categoriesCount Int
  combosRun       Int
  createdLeads    Int
  updatedLeads    Int
  hotLeads        Int
  error           String?
}
